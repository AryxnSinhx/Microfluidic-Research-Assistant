══════════════════════\n#  CELL 2 — Paste into a NEW cell after kernel restart. Do NOT re-run Cell 1.\n# ════════════════════════════════════════════════════════════════════\n\nimport os\nos.environ[\"CUDA_VISIBLE_DEVICES\"] = \"0\"   # single T4 — see note below on why not \"0,1\"\nimport gc\nimport json\nimport torch\nimport wandb\nfrom huggingface_hub import login\nfrom datasets import load_dataset\nfrom transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\nfrom peft import LoraConfig, PeftModel, get_peft_model, prepare_model_for_kbit_training\nfrom trl import SFTConfig, SFTTrainer, DataCollatorForCompletionOnlyLM\n\ngc.collect()\ntorch.cuda.empty_cache()\n\n# Quick version assertions — catches \"kernel not restarted\" immediately\nimport transformers, trl, peft\nassert transformers.__version__ == \"4.44.2\", \\\n    f\"Wrong transformers {transformers.__version__} — did you restart the kernel after Cell 1?\"\nassert trl.__version__ == \"0.10.1\", \\\n    f\"Wrong trl {trl.__version__} — did you restart the kernel after Cell 1?\"\nassert peft.__version__ == \"0.12.0\", \\\n    f\"Wrong peft {peft.__version__} — did you restart the kernel after Cell 1?\"\nprint(\"✓ Version assertions passed\")\n\n# ── Configuration ────────────────────────────────────────────────────\n\nDATA_PATH   = \"/kaggle/input/datasets/aryxnsinhx1/dataset-1/final_training_mixture.jsonl\"\nOUTPUT_DIR  = \"/kaggle/working/mistral-raft-qlora\"\nMERGED_DIR  = \"/kaggle/working/mistral-raft-merged\"\nADAPTER_DIR = os.path.join(OUTPUT_DIR, \"final_adapter\")\n\nHF_REPO_MERGED  = \"aryxnsinhx/mistral-7b-microfluidics-raft\"          # TODO: confirm this is your HF username\nHF_REPO_ADAPTER = \"aryxnsinhx/mistral-7b-microfluidics-raft-adapter\"  # TODO: confirm this is your HF username\n\nWANDB_PROJECT = \"microfluidics-raft-qlora\"\n\nMODEL_NAME        = \"mistralai/Mistral-7B-Instruct-v0.2\"\nTEXT_FIELD        = \"text\"       # verified key name from final_training_mixture.jsonl\nRESPONSE_TEMPLATE = \"[/INST]\"    # everything before this is masked from loss\n\n# Sequence length: verified from actual dataset\n#   median ≈ 987 tokens | p95 ≈ 1,777 tokens | max ≈ 2,205 tokens\nMAX_SEQ_LENGTH = 2048\n\nLORA_R              = 16\nLORA_ALPHA          = 32\nLORA_DROPOUT        = 0.05\nLORA_TARGET_MODULES = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n                        \"gate_proj\", \"up_proj\", \"down_proj\"]\n\n# Single T4: with device_map=\"auto\" splitting a 7B model across 2 GPUs,\n# each step runs strictly sequentially (GPU0 forward -> hop to GPU1 -> back)\n# with no data-parallel speedup — that's what produced the 28hr ETA.\n# A 7B model in 4-bit fits comfortably on one 16GB T4, so we keep it on\n# a single GPU and make up the effective batch size via grad accum instead.\n# Effective batch = 1 (per device) × 1 GPU × 16 (grad accum) = 16\nPER_DEVICE_BATCH_SIZE = 1\nGRAD_ACCUM_STEPS      = 16\nNUM_EPOCHS            = 3\nLEARNING_RATE         = 2e-4\nWARMUP_RATIO          = 0.03\nLOGGING_STEPS         = 10\nSAVE_STEPS            = 20\nEVAL_STEPS            = 20\nVAL_SPLIT             = 0.05\nSEED                  = 42\n\n\n# ── Credentials — same interactive flow as the Tier 1 Guanaco run ─────\n# This pops a token-entry widget for HF, then one for W&B.\n# You'll need write access on the HF token to push_to_hub later.\n\nlogin()\nwandb.login()\nos.environ[\"WANDB_PROJECT\"] = WANDB_PROJECT\nprint(\"✓ Logged in to HuggingFace and W&B\")\n\n# ── Sanity-check dataset ──────────────────────────────────────────────\n\nprint(f\"\\nChecking dataset at {DATA_PATH} ...\")\nwith open(DATA_PATH) as f:\n    lines = f.readlines()\nprint(f\"  Examples: {len(lines)}\")\nfor i, line in enumerate(lines):\n    obj = json.loads(line)\n    if TEXT_FIELD not in obj:\n        raise ValueError(f\"Line {i}: key '{TEXT_FIELD}' not found, got {list(obj.keys())}\")\n    if RESPONSE_TEMPLATE not in obj[TEXT_FIELD]:\n        raise ValueError(f\"Line {i}: '{RESPONSE_TEMPLATE}' missing — loss masking will break\")\nprint(f\"  ✓ All {len(lines)} examples are valid\")\n\n# ── Load tokenizer ───────────────────────────────────────────────────\n\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\ntokenizer.pad_token = tokenizer.eos_token\ntokenizer.padding_side = \"right\"\n\n\n# ── Load 4-bit model ─────────────────────────────────────────────────\n\nbnb_config = BitsAndBytesConfig(\n    load_in_4bit=True,\n    bnb_4bit_quant_type=\"nf4\",\n    bnb_4bit_use_double_quant=True,\n    bnb_4bit_compute_dtype=torch.float16,   # T4 (Turing) has no native bf16 tensor cores — fp16 is correct here\n)\n\nmodel = AutoModelForCausalLM.from_pretrained(\n    MODEL_NAME,\n    quantization_config=bnb_config,\n    device_map={\"\": 0},         # single GPU — see PER_DEVICE_BATCH_SIZE note above\n    torch_dtype=torch.float16,\n    low_cpu_mem_usage=True,\n)\nmodel.config.use_cache = False\nmodel.config.pretraining_tp = 1\nprint(model.dtype)\nprint(f\"Model loaded. Parameters: {model.num_parameters():,}\")\n\nmodel = prepare_model_for_kbit_training(model, use_gradient_checkpointing=True)\n\nlora_config = LoraConfig(\n    r=LORA_R,\n    lora_alpha=LORA_ALPHA,\n    lora_dropout=LORA_DROPOUT,\n    target_modules=LORA_TARGET_MODULES,\n    bias=\"none\",\n    task_type=\"CAUSAL_LM\",\n)\n\n# ── Dataset + loss masking ────────────────────────────────────────────\n\nraw   = load_dataset(\"json\", data_files=DATA_PATH, split=\"train\")\n\n# Drop instances that truncate before [/INST] at MAX_SEQ_LENGTH — these get\n# fully masked (-100) by DataCollatorForCompletionOnlyLM, and if one lands\n# alone in an eval batch, cross-entropy over zero valid tokens returns nan.\n# A nan eval_loss silently breaks load_best_model_at_end's comparison logic\n# (nan < x and nan > x are both False in Python), so filter before splitting.\nresponse_token_ids = tokenizer.encode(RESPONSE_TEMPLATE, add_special_tokens=False)\n\ndef has_response_template_within_budget(example):\n    ids = tokenizer(example[TEXT_FIELD], truncation=True, max_length=MAX_SEQ_LENGTH)[\"input_ids\"]\n    n = len(response_token_ids)\n    return any(ids[i:i+n] == response_token_ids for i in range(len(ids) - n + 1))\n\npre_filter_count = len(raw)\nraw = raw.filter(has_response_template_within_budget)\ndropped = pre_filter_count - len(raw)\nprint(f\"Filtered {dropped}/{pre_filter_count} instances that would truncate before {RESPONSE_TEMPLATE} \"\n      f\"({100*dropped/pre_filter_count:.1f}%)\")\n\nsplit = raw.train_test_split(test_size=VAL_SPLIT, seed=SEED)\ntrain_dataset = split[\"train\"]\neval_dataset  = split[\"test\"]\nprint(f\"Train: {len(train_dataset)} | Eval: {len(eval_dataset)}\")\n\ncollator = DataCollatorForCompletionOnlyLM(\n    response_template=RESPONSE_TEMPLATE,\n    tokenizer=tokenizer,\n)\n\n# ── Resume detection ──────────────────────────────────────────────────\n\ndef find_latest_checkpoint(output_dir):\n    if not os.path.isdir(output_dir):\n        return None\n    ckpts = [d for d in os.listdir(output_dir) if d.startswith(\"checkpoint-\")]\n    if not ckpts:\n        return None\n    ckpts.sort(key=lambda x: int(x.split(\"-\")[-1]))\n    return os.path.join(output_dir, ckpts[-1])\n\nresume_ckpt = find_latest_checkpoint(OUTPUT_DIR)\nprint(f\"{'Resuming from: ' + resume_ckpt if resume_ckpt else 'Starting fresh training run'}\")\n\n# ── SFTConfig + Trainer ─────────────────────────────────────────────\n\nsft_config = SFTConfig(\n    output_dir=OUTPUT_DIR,\n    dataset_text_field=TEXT_FIELD,\n    max_seq_length=MAX_SEQ_LENGTH,\n    per_device_train_batch_size=PER_DEVICE_BATCH_SIZE,\n    per_device_eval_batch_size=PER_DEVICE_BATCH_SIZE,\n    gradient_accumulation_steps=GRAD_ACCUM_STEPS,\n    num_train_epochs=NUM_EPOCHS,\n    learning_rate=LEARNING_RATE,\n    warmup_ratio=WARMUP_RATIO,\n    lr_scheduler_type=\"cosine\",\n    logging_steps=LOGGING_STEPS,\n    logging_first_step=True,\n    save_steps=SAVE_STEPS,\n    save_total_limit=3,\n    eval_strategy=\"steps\",   # renamed from evaluation_strategy (deprecated as of transformers 4.46+ warnings)\n    eval_steps=EVAL_STEPS,\n    load_best_model_at_end=True,\n    metric_for_best_model=\"eval_loss\",\n    greater_is_better=False,\n    bf16=False,\n    fp16=True,   # T4 has no native bf16 tensor cores; fp16 is the fast path here\n    optim=\"paged_adamw_8bit\",\n    max_grad_norm=0.3,\n    gradient_checkpointing=True,\n    gradient_checkpointing_kwargs={\"use_reentrant\": False},\n    report_to=\"wandb\",\n    run_name=\"mistral-7b-raft-qlora\",\n    seed=SEED,\n    packing=False,\n    ddp_find_unused_parameters=False,\n)\n\ntrainer = SFTTrainer(\n    model=model,\n    train_dataset=train_dataset,\n    eval_dataset=eval_dataset,\n    peft_config=lora_config,\n    args=sft_config,\n    data_collator=collator,\n    tokenizer=tokenizer,\n)\n\n# bf16 → fp32 cast on trainable params (LoRA adapters)\n# Prevents \"element 0 of tensors does not require grad\" on bitsandbytes 0.43.x\nfor name, p in trainer.model.named_parameters():\n    if p.requires_grad and p.dtype != torch.float32:\n        p.data = p.data.to(torch.float32)\n\nprint(type(trainer.model))\nfor name, p in trainer.model.named_parameters():\n    if p.requires_grad:\n        print(name, p.dtype)\n        break\n\n# ── Train ─────────────────────────────────────────────────────────────\n\nprint(\"Starting training...\")\ntrainer.train(resume_from_checkpoint=resume_ckpt)\n\ntrainer.model.save_pretrained(ADAPTER_DIR)\ntokenizer.save_pretrained(ADAPTER_DIR)\nprint(f\"✓ Saved final LoRA adapter to {ADAPTER_DIR}\")\n\n\n# ── Merge + push to HuggingFace ───────────────────────────────────────\n# Load base in fp16 (not 4-bit) — merging into a quantized model degrades quality\n# No token= args needed below — the earlier login() call already\n# authenticated this session, same as the Tier 1 script.\n\nprint(\"\\n=== Merging adapter into base weights ===\")\ndel model\ndel trainer\ngc.collect()\ntorch.cuda.empty_cache()\n\nbase = AutoModelForCausalLM.from_pretrained(\n    MODEL_NAME, torch_dtype=torch.float16, device_map=\"auto\"\n)\nmerged = PeftModel.from_pretrained(base, ADAPTER_DIR)\nmerged = merged.merge_and_unload()\nprint(\"✓ Merged\")\n\nos.makedirs(MERGED_DIR, exist_ok=True)\nmerged.save_pretrained(MERGED_DIR, safe_serialization=True)\ntokenizer.save_pretrained(MERGED_DIR)\nprint(f\"✓ Saved to {MERGED_DIR}\")\n\nprint(f\"\\nPushing merged model → {HF_REPO_MERGED}\")\nmerged.push_to_hub(HF_REPO_MERGED, private=True, safe_serialization=True)\ntokenizer.push_to_hub(HF_REPO_MERGED)\nprint(f\"✓ https://huggingface.co/{HF_REPO_MERGED}\")\n\nprint(f\"\\nPushing LoRA adapter → {HF_REPO_ADAPTER}\")\nadapter_base = AutoModelForCausalLM.from_pretrained(\n    MODEL_NAME, torch_dtype=torch.float16, device_map=\"cpu\"\n)\nadapter_model = PeftModel.from_pretrained(adapter_base, ADAPTER_DIR)\nadapter_model.push_to_hub(HF_REPO_ADAPTER, private=True)\ntokenizer.push_to_hub(HF_REPO_ADAPTER)\nprint(f\"✓ https://huggingface.co/{HF_REPO_ADAPTER}\")\n\nprint(\"\\n✓ All done.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}